#
# Copy to .env.local and fill in. .env.local is gitignored and must stay that way.

# Discord bot token, for the interactive chat commands.
# Discord Developer Portal > your application > Bot > Reset Token.
DISCORD_BOT_TOKEN=

# Discord webhook URL, for posting diagnoses.
# Channel settings > Integrations > Webhooks > New Webhook > Copy URL.
DISCORD_WEBHOOK=

# Where to reach Prometheus. These values are for running the detective
# directly on a workstation; docker-compose.yml overrides them with the
# container name when running inside the profiler network.
PROMETHEUS_HOST=localhost
PROMETHEUS_PORT=9090

# Claude Code authentication for headless use. Generate with:
#   claude setup-token
# Valid for one year. Requires a Pro, Max, Team or Enterprise plan.
# Note the expiry somewhere visible: claude -p fails silently once it lapses.
CLAUDE_CODE_OAUTH_TOKEN=

# Timezone for timestamps in diagnoses. Set to wherever the people reading
# the reports are, not necessarily where the cluster is.
TZ=UTC
