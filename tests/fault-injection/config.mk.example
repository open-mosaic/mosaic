# Copy this file to `config.mk` and edit for your cluster:
#   cp config.mk.example config.mk
# config.mk is gitignored, so your site values never get committed.
#
# IMPORTANT: edit values in place — do NOT paste a second copy below the
# originals. Make uses the LAST assignment, so a leftover placeholder line
# further down will silently override your value. (The harness guards against
# the known placeholders, but duplicates of real values can still bite.)
#
# The values below are a worked example: a 2-node cluster (2 GPUs/node) on a
# 1 GbE TCP interconnect, running nccl-tests. Yours will differ.

# ── Cluster topology ─────────────────────────────────────────────────────────
# Tip: if your OpenMosaic deployment already lists nodes in
# deployments/file_sd_configs/, that's your NODES list.
#
# NOTE: IFACE is a single value applied to every node — the current
# implementation assumes all nodes share the same interconnect interface name.
# Per-node interface names are a future improvement.
#
# NOTE: RANK_HOSTS / RANK_GPUS are filled in by hand for now. They could be
# auto-detected (e.g. from the launcher's rank assignment) in a future
# improvement.
NODES      := node-a node-b
IFACE      := eth0                                   # interconnect NIC (same on all nodes)
RANK_HOSTS := 0:node-a 1:node-a 2:node-b 3:node-b    # rank -> node
RANK_GPUS  := 0:0 1:1 2:0 3:1                         # rank -> local GPU index

# ── Observability ────────────────────────────────────────────────────────────
PROM           := http://localhost:9090         # Prometheus (usually on the head node)
COLLECTOR_HOST := node-a                         # node running the OTel collector
COLLECTOR_CT   := otel-lgtm                       # its container name (docker ps)
COLLECTOR_PROC := otelcol-contrib                 # its process name (pgrep -x, from host)

# ── Workload (reference launcher: nccl-tests over TCP) ───────────────────────
# The harness only needs WORKLOAD_PROC to detect the job. WORKLOAD_CMD is run by
# `make workload`; replace it wholesale for a different workload/transport.
# WORKLOAD_CMD must be a single shell command with NO single quotes.
WORKLOAD_PROC     := all_reduce_perf
WORKLOAD_LAUNCHER := mpirun

MPI  := /opt/openmpi
NN   := /home/user/nccl-tests            # dir holding the benchmark + plugins
OTLP := http://$(COLLECTOR_HOST):4318    # collector OTLP endpoint (reuses COLLECTOR_HOST)

WORKLOAD_CMD := cd $(NN) && $(MPI)/bin/mpirun -np 4 -H node-a:2,node-b:2 \
  -mca coll_hcoll_enable 0 -mca btl_tcp_if_include $(IFACE) \
  -x LD_LIBRARY_PATH=$(NN):$(NN)/plugins-lib:$(MPI)/lib \
  -x NCCL_PROFILER_PLUGIN=otel \
  -x NCCL_PROFILER_OTEL_TELEMETRY_ENDPOINT=$(OTLP) \
  -x NCCL_IB_DISABLE=1 -x NCCL_P2P_DISABLE=1 -x NCCL_SHM_DISABLE=1 \
  -x NCCL_SOCKET_IFNAME=$(IFACE) \
  $(NN)/all_reduce_perf -b 8M -e 8M -f 2 -g 1 -n 200000 -c 0

# ── Optional overrides (sensible defaults in the Makefile) ───────────────────
# CLK     := 800                        # T2.2 default clamp (MHz)
# DEADMAN := 300                        # auto-restore window (s); 0 disables
# PIDFILE := /tmp/mosaic-fault-timers.pgids   # where armed timers are recorded
